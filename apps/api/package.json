  "author": "DucHoang",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "set TS_NODE_TRANSPILE_ONLY=true&& node --env-file=.env --loader ts-node/esm index.ts",
    "pretest": "tsc -p tsconfig.json",
    "prisma:generate": "node ../../node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:push": "node ../../node_modules/prisma/build/index.js db push --schema prisma/schema.prisma",
    "start": "set TS_NODE_TRANSPILE_ONLY=true&& node --env-file=.env --loader ts-node/esm index.ts",
    "test": "node --test dist/src/tests/organization.service.test.js dist/src/tests/user.service.test.js dist/src/tests/permission.service.test.js dist/src/tests/auth.service.test.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
